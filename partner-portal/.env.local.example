# ── HubSpot ────────────────────────────────────────────────────────────────
# Access token for your installed HubSpot app (NOT a Private App token).
# Get it from: hs project open → your app → Auth tab → Access token
# Generated when you install the app on your portal (see docs/hubspot-setup.md)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Custom object type IDs — assigned by HubSpot when the project is deployed.
# Find them in: HubSpot Settings → Objects → Custom Objects
# Format: "2-XXXXXXXX" — these are unique to your portal, not portable.
HUBSPOT_PARTNER_ONBOARDING_OBJECT_TYPE_ID=2-XXXXXXXX
HUBSPOT_DEAL_REG_OBJECT_TYPE_ID=2-XXXXXXXX
HUBSPOT_MDF_REQUEST_OBJECT_TYPE_ID=2-XXXXXXXX

# Conflict-detection ticket pipeline.
# Create a Tickets pipeline in HubSpot and paste the pipeline/stage IDs here.
# Find them in: Settings → Objects → Tickets → Pipelines → Edit → copy IDs from URL
HUBSPOT_CONFLICT_TICKET_PIPELINE_ID=
HUBSPOT_CONFLICT_TICKET_STAGE_NEW=

# Per-tier product price books (Settings → Commerce → Price Books).
# Create one price book per partner tier and paste their IDs here.
HUBSPOT_PRICE_BOOK_PLATINUM=
HUBSPOT_PRICE_BOOK_GOLD=
HUBSPOT_PRICE_BOOK_SILVER=
HUBSPOT_PRICE_BOOK_REGISTERED=

# ── Auth ───────────────────────────────────────────────────────────────────
# Shared password used to authenticate all partner users in this demo.
# Partners sign in with their HubSpot Contact email + this password.
# In production, replace with a real SSO provider (Entra, Okta, Auth0, etc.)
DEMO_PASSWORD=changeme

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Dev bypass (skip auth entirely for local testing) ──────────────────────
# Uncomment to skip the login page and impersonate any partner by HubSpot company ID.
# DEV_BYPASS_AUTH=true
# DEV_TIER=gold
# DEV_COMPANY_NAME=Acme Corp
# DEV_COMPANY_ID=       # HubSpot company ID — found in the company record URL
# DEV_MDF_BALANCE=50000
